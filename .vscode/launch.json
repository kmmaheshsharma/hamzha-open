        {
            "type": "java",
            "name": "Debug - OpenDental API (Supabase)",
            "request": "launch",
            "mainClass": "com.clinic.opendental.OpenDentalApiApplication",
            "projectName": "api",
            "env": {
                "SPRING_PROFILES_ACTIVE": "dev",
                "SUPABASE_DB_URL": "jdbc:postgresql://db.qpjofnaucxsskamuepkh.supabase.co:5432/postgres?sslmode=require",
