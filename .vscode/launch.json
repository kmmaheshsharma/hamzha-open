        {
            "type": "java",
            "name": "Debug - OpenDental API (Remote Supabase)",
            "request": "launch",
            "mainClass": "com.clinic.opendental.OpenDentalApiApplication",
            "projectName": "api",
            "env": {
                "SPRING_PROFILES_ACTIVE": "dev",
                "SUPABASE_DB_URL": "${input:supabaseDbUrl}",
