    "inputs": [
        {
            "id": "supabaseDbUrl",
            "type": "promptString",
            "description": "Supabase JDBC URL",
            "default": "jdbc:postgresql://db.qpjofnaucxsskamuepkh.supabase.co:5432/postgres?sslmode=require"
        },
        {
            "id": "supabaseDbUsername",
            "type": "promptString",
            "description": "Supabase DB Username",
            "default": "postgres"
        },
        {
            "id": "supabaseDbPassword",
            "type": "promptString",
            "description": "Supabase DB Password"
        }
    ]
